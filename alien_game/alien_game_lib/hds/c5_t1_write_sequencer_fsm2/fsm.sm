second (MLText
uid 27,0
va (VaSet
font "arial,8,0"
)
xt "220,26400,18620,43400"
st "-- state register
current_state <= next_state;

-- step counter
if current_state = DO_WRITE_GAME then
  if step_q = 5  then
    step_q <= 0;
  else
    step_q <= step_q + 1;
  end if;
elsif current_state = DO_WRITE_VICTORY  then
  if step_q = 40  then
    step_q <= 0;
  else
    step_q <= step_q + 1;
  end if;
end if;"
tm "Actions"
)
