       module_select <= \"01\"; gun_px_idx <= \"00\";

    elsif step_q = 2 then
       module_select <= \"01\"; gun_px_idx <= \"01\";

    elsif step_q = 3 then
      module_select <= \"01\"; gun_px_idx <= \"10\";

    elsif step_q = 4 then
       module_select <= \"01\"; gun_px_idx <= \"11\";

    elsif step_q = 5 then
       module_select <= \"10\"; -- bullet

    end if;"
tm "Actions"
)
exitActions (MLText
