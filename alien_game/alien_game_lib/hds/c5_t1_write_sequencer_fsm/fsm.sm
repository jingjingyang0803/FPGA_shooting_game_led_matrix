inActions (MLText
uid 243,0
va (VaSet
font "arial,8,0"
)
xt "59710,6686,72510,40686"
st "write_pulse <= '1' ;
if step_q = \"000\" then
    module_select <= \"00\";

elsif step_q = \"001\" then
    module_select <= \"01\";
    gun_px_idx <= \"00\";

elsif step_q = \"010\" then
    module_select <= \"01\";
    gun_px_idx <= \"01\";

elsif step_q = \"011\" then
    module_select <= \"01\";
    gun_px_idx <= \"10\";

elsif step_q = \"100\" then
    module_select <= \"01\";
    gun_px_idx <= \"11\";

elsif step_q = \"101\" then
    module_select <= \"10\";

end if;

case step_q is
  when \"000\" => step_q <= \"001\";
  when \"001\" => step_q <= \"010\";
  when \"010\" => step_q <= \"011\";
  when \"011\" => step_q <= \"100\";
  when \"100\" => step_q <= \"101\";  
  when \"101\" => step_q <= \"000\";  
  when others => step_q <= \"000\";
end case;"
tm "Actions"
)
