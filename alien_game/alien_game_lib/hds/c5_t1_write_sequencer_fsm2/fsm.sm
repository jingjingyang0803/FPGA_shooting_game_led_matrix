else
    if    step_q = 0 then
     module_select <= \"00\"; -- alien

    elsif step_q = 1 then
       module_select <= \"01\"; gun_px_idx <= \"00\";

    elsif step_q = 2 then
       module_select <= \"01\"; gun_px_idx <= \"01\";

    elsif step_q = 3 then
      module_select <= \"01\"; gun_px_idx <= \"10\";

    elsif step_q = 4 then
       module_select <= \"01\"; gun_px_idx <= \"11\";

    elsif step_q = 5 then
       module_select <= \"10\"; -- bullet

    end if;
end if;"
tm "Actions"
)
